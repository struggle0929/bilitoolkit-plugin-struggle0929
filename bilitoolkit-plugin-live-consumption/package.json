    "bilitoolkit-ui": "^1.0.1",
    "element-plus": "^2.13.7",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
