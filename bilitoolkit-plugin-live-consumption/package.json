  "files": [
    "dist",
    "!dist/bundle-stats.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/struggle0929/bilitoolkit-plugin-struggle0929.git",
    "directory": "bilitoolkit-plugin-live-consumption"
  },
  "bugs": {
