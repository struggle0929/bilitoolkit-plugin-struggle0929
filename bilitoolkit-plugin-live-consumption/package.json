  },
  "homepage": "https://github.com/struggle0929/bilitoolkit-plugin-struggle0929/tree/main/bilitoolkit-plugin-live-consumption#readme",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "删除缓存": "rimraf node_modules/.vite",
    "check": "vue-tsc --build --noEmit && eslint .",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "dev": "rimraf node_modules/.vite && chcp 65001 && vite",
    "dev(cache)": "chcp 65001 && vite",
    "build": "vite build",
    "npm login": "npm login",
    "pnpm publish": "pnpm publish --access public"
  },
  "dependencies": {
