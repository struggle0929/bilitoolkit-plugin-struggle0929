    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1",
    "sass": "^1.92.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.3.3",
    "vue-tsc": "^3.0.4"
